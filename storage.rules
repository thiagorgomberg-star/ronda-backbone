rules_version = '2';
// Regras do Storage — fotos das inspeções/corretivas, fotos da rede e traçados grandes
service firebase.storage {
  match /b/{bucket}/o {
    match /orgs/{org}/{caminho=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 15 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/json');
    }
  }
}
